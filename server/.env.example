# ── Serveur EdyEco ────────────────────────────────────────────────────────────
# Copiez ce fichier en `server/.env` pour le développement local.

NODE_ENV=development
PORT=4000
SITE_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:5173

# Base de données
# Laissez DATABASE_URL vide pour utiliser PostgreSQL embarqué (PGlite, zéro installation).
# En production, renseignez la chaîne de connexion PostgreSQL.
# DATABASE_URL=postgres://user:password@host:5432/edyeco
DB_SSL=false
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true

# Sécurité — obligatoire en production (32 caractères minimum)
JWT_SECRET=changez-ce-secret-de-developpement-en-production-32-caracteres
JWT_EXPIRES=7d
COOKIE_SECURE=false
# COOKIE_DOMAIN=.edyeco.fr

# Compte administrateur initial (créé au premier seed)
ADMIN_EMAIL=admin@edyeco.com
ADMIN_PASSWORD=pypython10
ADMIN_NAME=Administrateur EdyEco

# Médias
UPLOADS_DIR=./uploads
MAX_UPLOAD_BYTES=6291456

# Emails (si SMTP_HOST est vide, les emails sont simulés dans les logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EdyEco <contact@edyeco.fr>
MAIL_TO=contact@edyeco.fr

# Paiement — simulation uniquement pour le moment.
# Passage à Stripe : PAYMENT_MODE=stripe + clés ci-dessous + implémentation du provider.
PAYMENT_MODE=simulation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Derrière un reverse proxy (Nginx, Traefik, Render, Railway…)
TRUST_PROXY=false
