# ── docker compose ────────────────────────────────────────────────────────────
# Copiez ce fichier en `.env` puis : docker compose up -d --build

POSTGRES_DB=edyeco
POSTGRES_USER=edyeco
POSTGRES_PASSWORD=changez-ce-mot-de-passe-postgres

# URL publique du site (canonical, sitemap, emails)
SITE_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:4000

# Sécurité — 32 caractères aléatoires minimum
JWT_SECRET=changez-ce-secret-jwt-de-production-32-caracteres-minimum
COOKIE_SECURE=false
TRUST_PROXY=false

# Compte administrateur initial
ADMIN_EMAIL=admin@edyeco.com
ADMIN_PASSWORD=pypython10
ADMIN_NAME=Administrateur EdyEco

# SMTP (facultatif : sans configuration, les emails sont simulés)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EdyEco <contact@edyeco.fr>
MAIL_TO=contact@edyeco.fr
